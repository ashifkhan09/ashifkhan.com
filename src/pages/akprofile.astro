---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import photo1 from '../assets/akprofile/photo-1.jpg';
import photo2 from '../assets/akprofile/photo-2.jpg';
import photo3 from '../assets/akprofile/photo-3.jpg';
import photo4 from '../assets/akprofile/photo-4.jpg';
import photo5 from '../assets/akprofile/photo-5.jpg';
import photo6 from '../assets/akprofile/photo-6.jpg';
import photo7 from '../assets/akprofile/photo-7.jpg';
import photo8 from '../assets/akprofile/photo-8.jpg';
import photo9 from '../assets/akprofile/photo-9.jpg';
import photo10 from '../assets/akprofile/photo-10.jpg';

const photoSources = [photo1, photo2, photo3, photo4, photo5, photo6, photo7, photo8, photo9, photo10];
const photos = await Promise.all(
  photoSources.map(async (src, i) => {
    const thumb = await getImage({ src, width: 480, height: 640, format: 'webp' });
    const full = await getImage({ src, width: 1400, format: 'webp' });
    return {
      thumb: thumb.src,
      full: full.src,
      alt: `Photo ${i + 1}`,
    };
  })
);

const profile = {
  name: 'Ashif Khan',
  tag: 'NYC ↔ Raleigh, usually somewhere between a trail and a bookshelf',
};

const fieldStats = [
  { icon: '📏', label: "5'10\"" },
  { icon: '📍', label: 'NYC and Raleigh' },
  { icon: '🍷', label: "Doesn't drink" },
  { icon: '🚬', label: "Doesn't smoke" },
];

const prompts = [
  {
    question: "Where I'm happiest",
    answer:
      "On a trail somewhere, on the back of my motorcycle with no particular destination, deep in a good book, or curled up for a movie night with people I love.",
  },
  {
    question: "What I'm building this year",
    answer:
      'A life that feels calm, meaningful, and a little adventurous — less noise, more time outdoors and with the people who matter.',
  },
  {
    question: 'What my faith looks like, day to day',
    answer:
      'Faith shows up in small, steady things for me — prayer, dua, trying to keep good akhlaq, choosing halal without making it complicated. Still learning, still working on being better at it every day.',
  },
  {
    question: "What I'm looking for",
    answer:
      "Kindness, sincerity in faith, and emotional maturity, the rest gets easier with those three. Someone who treats disagreements like a team working things out, not a fight to win, and who brings a sense of peace into a room rather than chaos.",
  },
];

const faithChips = [
  'Sunni',
  'Fasting',
  'Friday Prayer',
  'Only eats halal food',
  'Frequent Dua',
  'Good Akhlaq',
  'Charity Work',
  'Completed Umrah',
  'Learning Arabic Speaking',
];

const interestChips = ['Boxing', 'Calisthenics', 'Cricket', 'Running', 'Swimming', 'Tennis', 'Volleyball', 'Yoga', 'Pickleball', 'Bouldering'];

const personalityChips = ['Affectionate', 'Carefree', 'Cheerful', 'Entrepreneurial', 'Family-oriented'];

const bio = [
  "It's the simple things, a quiet morning, a good trail, a conversation that doesn't need to be rushed. I split my time between staying active outdoors, catching up with close friends over coffee, and just as easily settling into a quiet evening at home. Family, faith, and steady growth sit at the center of how I try to live.",
  "What I'm building toward is a peaceful home, two people helping each other grow, showing up with patience more than perfection, and choosing to be on the same team even when things get hard. I'd rather spend a night under the stars after a hike than chase noise, and I'm looking for someone who wants that kind of quiet, steady life too.",
];
---

<BaseLayout
  title="Ashif Khan"
  description="A private profile page."
  noindex={true}
>
  <!-- ── TRAILHEAD (HERO) ── -->
  <section class="trailhead">
    <div class="trailhead-photo">
      <img src={photos[0].full} alt={photos[0].alt} />
      <div class="trailhead-photo-scrim"></div>
    </div>
    <div class="trailhead-content">
      <p class="trailhead-kicker hero-in hero-in-1">A Private Profile</p>
      <h1 class="trailhead-name hero-in hero-in-2">{profile.name}</h1>
      <p class="trailhead-tag hero-in hero-in-3">{profile.tag}</p>
    </div>
  </section>

  <!-- ── FIELD STATS ── -->
  <section class="field-stats">
    <div class="section field-stats-inner">
      {fieldStats.map((stat, i) => (
        <>
          {i > 0 && <span class="field-stat-divider" aria-hidden="true"></span>}
          <span class="field-stat">{stat.label}</span>
        </>
      ))}
    </div>
  </section>

  <!-- ── THE TRAIL ── -->
  <div class="trail" id="trail">
    <div class="trail-track">
      <svg class="trail-wave-svg" viewBox="0 0 24 100" preserveAspectRatio="none" aria-hidden="true">
        <path id="trailBasePath" class="trail-wave-path trail-wave-path--base" d="M12,0 L12,100" />
        <clipPath id="trailProgressClip">
          <rect id="trailProgressClipRect" x="0" y="0" width="24" height="0" />
        </clipPath>
        <path id="trailProgressPath" class="trail-wave-path trail-wave-path--progress" d="M12,0 L12,100" clip-path="url(#trailProgressClip)" />
      </svg>
    </div>

    <div class="trail-waypoint" data-waypoint="match">
      <span class="trail-dot"></span>
      <span class="trail-label">Match</span>
      <div class="prompt-card reveal">
        <p class="prompt-question">{prompts[0].question}</p>
        <p class="prompt-answer">{prompts[0].answer}</p>
      </div>
    </div>

    <div class="route reveal">
      <p class="route-label">The Route</p>
      <div class="route-strip" id="routeStrip">
        {photos.map((photo, i) => (
          <button class="route-thumb" data-index={i} aria-label={`Open photo ${i + 1} of ${photos.length}`}>
            <img src={photo.thumb} alt={photo.alt} loading="lazy" />
          </button>
        ))}
      </div>
    </div>

    <div class="trail-waypoint" data-waypoint="conversation">
      <span class="trail-dot"></span>
      <span class="trail-label">First conversation</span>
      <div class="prompt-card reveal">
        <p class="prompt-question">{prompts[1].question}</p>
        <p class="prompt-answer">{prompts[1].answer}</p>
      </div>
    </div>

    <div class="faith-block reveal">
      <p class="faith-label">My Faith</p>
      <div class="chip-grid">
        {faithChips.map((chip) => (
          <span class="chip">{chip}</span>
        ))}
      </div>
    </div>

    <div class="trail-waypoint" data-waypoint="date">
      <span class="trail-dot"></span>
      <span class="trail-label">First date</span>
      <div class="prompt-card reveal">
        <p class="prompt-question">{prompts[2].question}</p>
        <p class="prompt-answer">{prompts[2].answer}</p>
      </div>
    </div>

    <div class="bio-block reveal">
      <p class="bio-label">About</p>
      {bio.map((paragraph) => (
        <p class="bio-paragraph">{paragraph}</p>
      ))}
    </div>

    <div class="trail-waypoint" data-waypoint="family">
      <span class="trail-dot"></span>
      <span class="trail-label">Meet the family</span>
      <div class="prompt-card reveal">
        <p class="prompt-question">{prompts[3].question}</p>
        <p class="prompt-answer">{prompts[3].answer}</p>
      </div>
    </div>

    <div class="interests-block">
      <div class="faith-block reveal">
        <p class="faith-label">Interests</p>
        <div class="chip-grid">
          {interestChips.map((chip) => (
            <span class="chip">{chip}</span>
          ))}
        </div>
      </div>
      <div class="faith-block reveal">
        <p class="faith-label">Personality</p>
        <div class="chip-grid">
          {personalityChips.map((chip) => (
            <span class="chip">{chip}</span>
          ))}
        </div>
      </div>
    </div>

    <div class="trail-waypoint" data-waypoint="forever">
      <span class="trail-dot"></span>
      <span class="trail-label">Forever</span>
      <div class="cta-block reveal">
        <p class="cta-text">If this trail looks like one you'd want to walk too —</p>
        <a href="mailto:ashif@ashifkhan.com" class="cta-btn">Get in touch</a>
      </div>
    </div>
  </div>

    <div class="lightbox" id="lightbox" aria-hidden="true">
      <button class="lightbox-close" id="lightboxClose" aria-label="Close">✕</button>
      <button class="lightbox-prev" id="lightboxPrev" aria-label="Previous photo">‹</button>
      <img class="lightbox-img" id="lightboxImg" src="" alt="" />
      <button class="lightbox-next" id="lightboxNext" aria-label="Next photo">›</button>
    </div>

  <style>
    :global(:root) {
      --ease-premium: cubic-bezier(0.16, 1, 0.3, 1);
    }

    .trailhead {
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 92vh;
      background: var(--ink);
    }

    .trailhead-photo {
      position: relative;
      overflow: hidden;
    }

    .trailhead-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transform: scale(1.04);
    }

    .trailhead-photo-scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        90deg,
        transparent 55%,
        rgba(14, 14, 13, 0.55) 100%
      );
      pointer-events: none;
    }

    .trailhead-content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 5vw 6vw;
    }

    .hero-in {
      opacity: 0;
      transform: translateY(22px);
      animation: heroIn 1.1s var(--ease-premium) forwards;
    }

    .hero-in-1 { animation-delay: 0.1s; }
    .hero-in-2 { animation-delay: 0.25s; }
    .hero-in-3 { animation-delay: 0.42s; }

    @keyframes heroIn {
      to { opacity: 1; transform: translateY(0); }
    }

    .trailhead-kicker {
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--accent-light);
      margin-bottom: 1.75rem;
    }

    .trailhead-name {
      font-family: var(--serif);
      font-size: clamp(3.25rem, 7vw, 6.25rem);
      line-height: 0.98;
      color: var(--paper);
      letter-spacing: -0.035em;
      margin-bottom: 1.5rem;
    }

    .trailhead-tag {
      color: rgba(250, 249, 247, 0.55);
      font-size: 1.1875rem;
      font-weight: 300;
      line-height: 1.6;
      max-width: 34ch;
      letter-spacing: -0.005em;
    }

    @media (max-width: 768px) {
      .trailhead {
        grid-template-columns: 1fr;
        min-height: auto;
      }
      .trailhead-photo {
        aspect-ratio: 4 / 5;
      }
      .trailhead-photo-scrim {
        background: linear-gradient(180deg, transparent 55%, rgba(14, 14, 13, 0.65) 100%);
      }
      .trailhead-content {
        padding: 3rem 1.5rem 3.5rem;
      }
    }

    /* ── FIELD STATS ── */
    .field-stats {
      background: var(--paper-warm);
      border-bottom: 1px solid var(--border);
    }

    .field-stats-inner {
      padding: 1.75rem 2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 1.25rem;
    }

    .field-stat {
      font-size: 0.8125rem;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink-light);
      white-space: nowrap;
    }

    .field-stat-divider {
      width: 1px;
      height: 12px;
      background: var(--border-med);
    }

    @media (max-width: 640px) {
      .field-stats-inner {
        gap: 0.85rem;
        padding: 1.5rem 1.25rem;
      }
      .field-stat {
        font-size: 0.75rem;
      }
    }

    /* ── TRAIL ── */
    .trail {
      position: relative;
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 8rem 2rem 8rem 4rem;
      background: var(--paper);
    }

    .trail :global(.reveal) {
      transition-timing-function: var(--ease-premium);
      transition-duration: 0.9s;
    }

    .trail-track {
      position: absolute;
      left: calc(2rem - 11px);
      top: 5rem;
      bottom: 5rem;
      width: 24px;
      pointer-events: none;
    }

    .trail-wave-svg {
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    .trail-wave-path {
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
    }

    .trail-wave-path--base {
      stroke: var(--border);
    }

    .trail-wave-path--progress {
      stroke: var(--accent);
    }

    .trail-waypoint {
      position: relative;
      margin-bottom: 6.5rem;
      padding-left: 2rem;
    }

    .trail-waypoint:last-child {
      margin-bottom: 0;
    }

    .trail-dot {
      position: absolute;
      left: -2.4rem;
      top: 0.15rem;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--paper);
      border: 2px solid var(--border-med);
      transition: background 0.3s, border-color 0.3s, transform 0.3s;
    }

    .trail-waypoint.lit .trail-dot {
      background: var(--accent);
      border-color: var(--accent);
      transform: scale(1.2);
    }

    .trail-label {
      display: block;
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin-bottom: 1rem;
      transition: color 0.3s;
    }

    .trail-waypoint.lit .trail-label {
      color: var(--accent);
    }

    .prompt-card {
      background: var(--paper-warm);
      border: none;
      border-radius: 20px;
      padding: 2.75rem;
      max-width: 62ch;
      box-shadow: 0 1px 2px rgba(14, 14, 13, 0.03), 0 16px 40px -24px rgba(14, 14, 13, 0.14);
    }

    .prompt-question {
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin-bottom: 1rem;
    }

    .prompt-answer {
      font-family: var(--serif);
      font-size: 1.625rem;
      line-height: 1.42;
      color: var(--ink);
      letter-spacing: -0.015em;
    }

    @media (max-width: 768px) {
      .trail {
        padding: 4rem 1.25rem 4rem 3rem;
      }
      .trail-waypoint {
        margin-bottom: 4rem;
      }
      .trail-track {
        left: calc(1.25rem - 11px);
      }
      .trail-dot {
        left: -1.65rem;
      }
      .prompt-card {
        padding: 1.75rem;
        border-radius: 16px;
      }
      .prompt-answer {
        font-size: 1.25rem;
      }
    }

    /* ── ROUTE (GALLERY) ── */
    .route {
      margin: 0 -4rem 0 -4rem;
      padding: 0 4rem;
    }

    .route-label {
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin-bottom: 1rem;
    }

    .route-strip {
      display: flex;
      gap: 0.75rem;
      overflow-x: auto;
      overflow-y: visible;
      scroll-snap-type: x mandatory;
      padding: 1rem 0 0.5rem;
    }

    .route-thumb {
      flex: 0 0 auto;
      width: 240px;
      aspect-ratio: 3 / 4;
      border: none;
      border-radius: 18px;
      overflow: hidden;
      padding: 0;
      cursor: pointer;
      scroll-snap-align: start;
      background: var(--paper-warm);
      transform-origin: center bottom;
      transition: transform 0.35s var(--ease-premium), box-shadow 0.35s var(--ease-premium);
      box-shadow: 0 1px 2px rgba(14, 14, 13, 0.04), 0 12px 28px -18px rgba(14, 14, 13, 0.22);
      will-change: transform;
    }

    .route-thumb:hover {
      box-shadow: 0 1px 2px rgba(14, 14, 13, 0.05), 0 24px 48px -20px rgba(14, 14, 13, 0.32);
    }

    .route-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* ── LIGHTBOX ── */
    .lightbox {
      position: fixed;
      inset: 0;
      background: rgba(14, 14, 13, 0.85);
      backdrop-filter: blur(28px) saturate(1.4);
      -webkit-backdrop-filter: blur(28px) saturate(1.4);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.4s var(--ease-premium);
      z-index: 200;
    }

    .lightbox.open {
      opacity: 1;
      pointer-events: auto;
    }

    .lightbox-img {
      max-width: min(88vw, 900px);
      max-height: 85vh;
      object-fit: contain;
      border-radius: 14px;
      box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.6);
    }

    .lightbox-close,
    .lightbox-prev,
    .lightbox-next {
      position: absolute;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: rgba(250, 249, 247, 0.08);
      border: 1px solid rgba(250, 249, 247, 0.16);
      color: var(--paper);
      font-size: 1.375rem;
      cursor: pointer;
      opacity: 0.85;
      transition: opacity 0.2s, background 0.2s, transform 0.2s;
    }

    .lightbox-close:hover,
    .lightbox-prev:hover,
    .lightbox-next:hover {
      opacity: 1;
      background: rgba(250, 249, 247, 0.16);
      transform: scale(1.06);
    }

    .lightbox-close {
      top: 1.5rem;
      right: 1.5rem;
    }

    .lightbox-prev {
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
    }

    .lightbox-next {
      right: 1rem;
      top: 50%;
      transform: translateY(-50%);
    }

    @media (max-width: 768px) {
      .route {
        margin: 0 -1.25rem;
        padding: 0 1.25rem;
      }
      .route-thumb {
        width: 150px;
      }
    }

    /* ── FAITH / CHIP GRID ── */
    .faith-block {
      margin-bottom: 4rem;
    }

    .faith-label {
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin-bottom: 1rem;
    }

    .chip-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      max-width: 60ch;
    }

    /* ── BIO ── */
    .bio-block {
      margin-bottom: 4rem;
      max-width: 60ch;
    }

    .bio-label {
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin-bottom: 1rem;
    }

    .bio-paragraph {
      color: var(--ink-light);
      line-height: 1.75;
      font-weight: 300;
      margin-bottom: 1rem;
    }

    .bio-paragraph:last-child {
      margin-bottom: 0;
    }

    .interests-block .faith-block:last-child {
      margin-bottom: 4rem;
    }

    /* ── CTA ── */
    .cta-block {
      max-width: 60ch;
    }

    .cta-text {
      font-family: var(--serif);
      font-size: clamp(1.75rem, 3vw, 2.25rem);
      color: var(--ink);
      line-height: 1.25;
      letter-spacing: -0.015em;
      margin-bottom: 2rem;
    }

    .cta-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      background: var(--ink);
      color: var(--paper);
      font-size: 0.9375rem;
      font-weight: 500;
      letter-spacing: -0.005em;
      padding: 1rem 1.75rem;
      border-radius: 100px;
      text-decoration: none;
      box-shadow: 0 1px 2px rgba(14, 14, 13, 0.08), 0 20px 40px -18px rgba(14, 14, 13, 0.35);
      transition: transform 0.35s var(--ease-premium), box-shadow 0.35s var(--ease-premium);
    }

    .cta-btn::after {
      content: '→';
      transition: transform 0.35s var(--ease-premium);
    }

    .cta-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 1px 2px rgba(14, 14, 13, 0.08), 0 28px 52px -16px rgba(14, 14, 13, 0.42);
    }

    .cta-btn:hover::after {
      transform: translateX(3px);
    }

    /* ── CHIPS (page-local refinement) ── */
    .chip-grid .chip,
    .field-stats-inner .chip {
      background: transparent;
      border: 1px solid var(--border-med);
      color: var(--ink-light);
      font-weight: 400;
      letter-spacing: 0.01em;
      transition: border-color 0.25s var(--ease-premium), color 0.25s var(--ease-premium), transform 0.25s var(--ease-premium);
    }

    .chip-grid .chip:hover {
      border-color: var(--accent);
      color: var(--accent);
      transform: translateY(-1px);
    }

    /* ── MAGNETIC TEXT ── */
    .mword {
      display: inline-block;
      will-change: transform;
    }
  </style>

  <script define:vars={{ photos }}>
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightboxImg');
    const closeBtn = document.getElementById('lightboxClose');
    const prevBtn = document.getElementById('lightboxPrev');
    const nextBtn = document.getElementById('lightboxNext');
    const thumbs = document.querySelectorAll('.route-thumb');
    let currentIndex = 0;

    function showPhoto() {
      const photo = photos[currentIndex];
      lightboxImg.src = photo.full;
      lightboxImg.alt = photo.alt;
    }

    function openLightbox(index) {
      currentIndex = index;
      showPhoto();
      lightbox.classList.add('open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox.classList.remove('open');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function nextPhoto() {
      currentIndex = (currentIndex + 1) % photos.length;
      showPhoto();
    }

    function prevPhoto() {
      currentIndex = (currentIndex - 1 + photos.length) % photos.length;
      showPhoto();
    }

    thumbs.forEach((btn, i) => btn.addEventListener('click', () => openLightbox(i)));
    closeBtn?.addEventListener('click', closeLightbox);
    nextBtn?.addEventListener('click', nextPhoto);
    prevBtn?.addEventListener('click', prevPhoto);

    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox?.classList.contains('open')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') nextPhoto();
      if (e.key === 'ArrowLeft') prevPhoto();
    });

    let touchStartX = 0;
    lightboxImg?.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0].clientX;
    });
    lightboxImg?.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      if (dx > 50) prevPhoto();
      if (dx < -50) nextPhoto();
    });
  </script>

  <script>
    const trail = document.getElementById('trail');
    const trailProgressClipRect = document.getElementById('trailProgressClipRect');

    function updateTrailProgress() {
      if (!trail || !trailProgressClipRect) return;
      const rect = trail.getBoundingClientRect();
      const total = rect.height;
      if (total <= 0) return;
      const viewed = Math.min(Math.max(window.innerHeight * 0.5 - rect.top, 0), total);
      const pct = (viewed / total) * 100;
      trailProgressClipRect.setAttribute('height', pct.toFixed(2));
    }

    window.addEventListener('scroll', updateTrailProgress, { passive: true });
    window.addEventListener('resize', updateTrailProgress);
    updateTrailProgress();

    const waypointObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('lit');
          }
        });
      },
      { threshold: 0.5 }
    );

    document.querySelectorAll('.trail-waypoint').forEach((el) => waypointObserver.observe(el));
  </script>

  <script>
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!prefersReducedMotion) {
      // ── Magnetic text: nearby words gently scale up toward the cursor ──
      function wrapWords(el) {
        const text = el.textContent;
        el.textContent = '';
        const frag = document.createDocumentFragment();
        text.split(/(\s+)/).forEach((chunk) => {
          if (chunk.trim() === '') {
            frag.appendChild(document.createTextNode(chunk));
          } else {
            const span = document.createElement('span');
            span.className = 'mword';
            span.textContent = chunk;
            frag.appendChild(span);
          }
        });
        el.appendChild(frag);
      }

      document
        .querySelectorAll('.trailhead-name, .trailhead-tag, .prompt-answer, .bio-paragraph, .cta-text')
        .forEach(wrapWords);

      const words = Array.from(document.querySelectorAll('.mword'));
      const wordScale = words.map(() => 1);
      let wordRects = [];
      let rectsTicking = false;

      function updateWordRects() {
        wordRects = words.map((w) => w.getBoundingClientRect());
        rectsTicking = false;
      }
      updateWordRects();

      window.addEventListener(
        'scroll',
        () => {
          if (!rectsTicking) {
            rectsTicking = true;
            requestAnimationFrame(updateWordRects);
          }
        },
        { passive: true }
      );
      window.addEventListener('resize', updateWordRects);

      // Real cursor position when the mouse is actively moving; otherwise we fall back
      // to a fixed reading line near the top of the viewport, so the effect still runs
      // off scroll position alone (e.g. scrolling with a trackpad, cursor never moving).
      let mouseX = window.innerWidth / 2;
      let mouseY = window.innerHeight * 0.4;
      let lastMouseMoveTime = 0;
      const MOUSE_IDLE_MS = 700;

      window.addEventListener(
        'mousemove',
        (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
          lastMouseMoveTime = performance.now();
        },
        { passive: true }
      );

      function isMouseActive() {
        return performance.now() - lastMouseMoveTime < MOUSE_IDLE_MS;
      }

      const WORD_RADIUS = 150;
      const WORD_MAX_BOOST = 0.7;

      function animateWords() {
        const active = isMouseActive();
        const focusX = active ? mouseX : window.innerWidth / 2;
        const focusY = active ? mouseY : window.innerHeight * 0.4;
        for (let i = 0; i < words.length; i++) {
          const rect = wordRects[i];
          if (!rect) continue;
          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;
          const dist = Math.hypot(focusX - cx, focusY - cy);
          const target = dist < WORD_RADIUS ? 1 + (1 - dist / WORD_RADIUS) * WORD_MAX_BOOST : 1;
          wordScale[i] += (target - wordScale[i]) * 0.28;
          if (Math.abs(wordScale[i] - 1) > 0.001) {
            words[i].style.transform = `scale(${wordScale[i].toFixed(3)})`;
          } else if (wordScale[i] !== 1) {
            words[i].style.transform = '';
            wordScale[i] = 1;
          }
        }
        requestAnimationFrame(animateWords);
      }
      requestAnimationFrame(animateWords);

      // ── Trail wave: the trail line ripples toward the cursor, like water ──
      const trackEl = document.querySelector('.trail-track');
      const basePath = document.getElementById('trailBasePath');
      const progressPath = document.getElementById('trailProgressPath');

      let waveTargetY = 50;
      let waveCurrentY = 50;
      let waveAmp = 0;
      let waveTargetAmp = 0;
      let trailMouseActive = false;

      window.addEventListener(
        'mousemove',
        (e) => {
          if (!trackEl) return;
          const rect = trackEl.getBoundingClientRect();
          const nearX = e.clientX > rect.left - 100 && e.clientX < rect.left + rect.width + 100;
          const withinY = e.clientY > rect.top && e.clientY < rect.bottom;
          trailMouseActive = nearX && withinY && rect.height > 0;
          if (trailMouseActive) {
            waveTargetY = ((e.clientY - rect.top) / rect.height) * 100;
          }
        },
        { passive: true }
      );

      // While the mouse isn't actively hovering the trail, ripple gently at a
      // fixed reading line so the wave still reacts as the page scrolls.
      function updateTrailWaveTarget() {
        if (trailMouseActive || !trackEl) return;
        const rect = trackEl.getBoundingClientRect();
        if (rect.height <= 0) {
          waveTargetAmp = 0;
          return;
        }
        const focusY = window.innerHeight * 0.4;
        const pct = ((focusY - rect.top) / rect.height) * 100;
        if (pct >= -10 && pct <= 110) {
          waveTargetY = Math.min(100, Math.max(0, pct));
          waveTargetAmp = 7;
        } else {
          waveTargetAmp = 0;
        }
      }

      function renderTrailWave() {
        updateTrailWaveTarget();
        if (trailMouseActive) waveTargetAmp = 11;
        if (basePath && progressPath) {
          waveCurrentY += (waveTargetY - waveCurrentY) * 0.18;
          waveAmp += (waveTargetAmp - waveAmp) * 0.14;

          const steps = 48;
          const sigma = 11;
          let d = '';
          for (let i = 0; i <= steps; i++) {
            const y = (100 / steps) * i;
            const bump = waveAmp * Math.exp(-((y - waveCurrentY) * (y - waveCurrentY)) / (2 * sigma * sigma));
            const x = 12 + bump;
            d += (i === 0 ? 'M' : 'L') + x.toFixed(2) + ',' + y.toFixed(2) + ' ';
          }
          d = d.trim();
          basePath.setAttribute('d', d);
          progressPath.setAttribute('d', d);
        }
        requestAnimationFrame(renderTrailWave);
      }
      requestAnimationFrame(renderTrailWave);

      // ── Photo dock: nearby thumbnails lift and scale toward the cursor ──
      const routeStrip = document.getElementById('routeStrip');
      const thumbButtons = Array.from(document.querySelectorAll('.route-thumb'));

      if (routeStrip && thumbButtons.length) {
        let thumbMouseX = -9999;
        let stripActive = false;

        routeStrip.addEventListener(
          'mousemove',
          (e) => {
            thumbMouseX = e.clientX;
            stripActive = true;
          },
          { passive: true }
        );
        routeStrip.addEventListener('mouseleave', () => {
          stripActive = false;
        });

        const thumbScale = thumbButtons.map(() => 1);
        const THUMB_RADIUS = 220;
        const THUMB_MAX_BOOST = 0.32;

        function animateThumbs() {
          for (let i = 0; i < thumbButtons.length; i++) {
            const rect = thumbButtons[i].getBoundingClientRect();
            const cx = rect.left + rect.width / 2;
            const dist = stripActive ? Math.abs(thumbMouseX - cx) : Infinity;
            const target = dist < THUMB_RADIUS ? 1 + (1 - dist / THUMB_RADIUS) * THUMB_MAX_BOOST : 1;
            thumbScale[i] += (target - thumbScale[i]) * 0.22;
            if (Math.abs(thumbScale[i] - 1) > 0.001) {
              const lift = (thumbScale[i] - 1) * 40;
              thumbButtons[i].style.transform = `translateY(${(-lift).toFixed(2)}px) scale(${thumbScale[i].toFixed(3)})`;
            } else if (thumbScale[i] !== 1) {
              thumbButtons[i].style.transform = '';
              thumbScale[i] = 1;
            }
          }
          requestAnimationFrame(animateThumbs);
        }
        requestAnimationFrame(animateThumbs);
      }
    }
  </script>
</BaseLayout>
