---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import photo1 from '../assets/akprofile/photo-1.jpg';
import photo2 from '../assets/akprofile/photo-2.jpg';
import photo3 from '../assets/akprofile/photo-3.jpg';
import photo4 from '../assets/akprofile/photo-4.jpg';
import photo5 from '../assets/akprofile/photo-5.jpg';
import photo6 from '../assets/akprofile/photo-6.jpg';
import photo7 from '../assets/akprofile/photo-7.jpg';
import photo8 from '../assets/akprofile/photo-8.jpg';
import photo9 from '../assets/akprofile/photo-9.jpg';
import photo10 from '../assets/akprofile/photo-10.jpg';

const photoSources = [photo1, photo2, photo3, photo4, photo5, photo6, photo7, photo8, photo9, photo10];
const photos = await Promise.all(
  photoSources.map(async (src, i) => {
    const thumb = await getImage({ src, width: 480, height: 640, format: 'webp' });
    const full = await getImage({ src, width: 1400, format: 'webp' });
    return {
      thumb: thumb.src,
      full: full.src,
      alt: `Photo ${i + 1}`,
    };
  })
);

const profile = {
  name: 'Ashif Khan',
  tag: 'NYC ↔ Raleigh, usually somewhere between a trail and a bookshelf',
};

const fieldStats = [
  { icon: '📏', label: "5'10\"" },
  { icon: '📍', label: 'NYC and Raleigh' },
  { icon: '🍷', label: "Doesn't drink" },
  { icon: '🚬', label: "Doesn't smoke" },
];

const prompts = [
  {
    question: "Where I'm happiest",
    answer:
      "On a trail somewhere, on the back of my motorcycle with no particular destination, deep in a good book, or curled up for a movie night with people I love.",
  },
  {
    question: "What I'm building this year",
    answer:
      'A life that feels calm, meaningful, and a little adventurous — less noise, more time outdoors and with the people who matter.',
  },
  {
    question: 'What my faith looks like, day to day',
    answer:
      'Faith shows up in small, steady things for me — prayer, dua, trying to keep good akhlaq, choosing halal without making it complicated. Still learning, still working on being better at it every day.',
  },
  {
    question: "What I'm looking for",
    answer:
      "Kindness, sincerity in faith, and emotional maturity, the rest gets easier with those three. Someone who treats disagreements like a team working things out, not a fight to win, and who brings a sense of peace into a room rather than chaos.",
  },
];

const faithChips = [
  'Sunni',
  'Fasting',
  'Friday Prayer',
  'Only eats halal food',
  'Frequent Dua',
  'Good Akhlaq',
  'Charity Work',
  'Completed Umrah',
  'Learning Arabic Speaking',
];

const interestChips = ['Boxing', 'Calisthenics', 'Cricket', 'Running', 'Swimming', 'Tennis', 'Volleyball', 'Yoga', 'Pickleball', 'Bouldering'];

const personalityChips = ['Affectionate', 'Carefree', 'Cheerful', 'Entrepreneurial', 'Family-oriented'];

const bio = [
  "It's the simple things, a quiet morning, a good trail, a conversation that doesn't need to be rushed. I split my time between staying active outdoors, catching up with close friends over coffee, and just as easily settling into a quiet evening at home. Family, faith, and steady growth sit at the center of how I try to live.",
  "What I'm building toward is a peaceful home, two people helping each other grow, showing up with patience more than perfection, and choosing to be on the same team even when things get hard. I'd rather spend a night under the stars after a hike than chase noise, and I'm looking for someone who wants that kind of quiet, steady life too.",
];
---

<BaseLayout
  title="Ashif Khan"
  description="A private profile page."
  noindex={true}
>
  <!-- ── TRAILHEAD (HERO) ── -->
  <section class="trailhead">
    <div class="trailhead-photo">
      <img src={photos[0].full} alt={photos[0].alt} />
      <div class="trailhead-photo-scrim"></div>
    </div>
    <div class="trailhead-content">
      <p class="trailhead-kicker hero-in hero-in-1">A Private Profile</p>
      <h1 class="trailhead-name hero-in hero-in-2">{profile.name}</h1>
      <p class="trailhead-tag hero-in hero-in-3">{profile.tag}</p>
    </div>
  </section>

  <!-- ── FIELD STATS ── -->
  <section class="field-stats">
    <div class="section field-stats-inner">
      {fieldStats.map((stat, i) => (
        <>
          {i > 0 && <span class="field-stat-divider" aria-hidden="true"></span>}
          <span class="field-stat">{stat.label}</span>
        </>
      ))}
    </div>
  </section>

  <!-- ── THE TRAIL ── -->
  <div class="trail" id="trail">
    <div class="trail-track">
      <div class="trail-progress" id="trailProgress"></div>
    </div>

    <div class="trail-waypoint" data-waypoint="match">
      <span class="trail-dot"></span>
      <span class="trail-label">Match</span>
      <div class="prompt-card reveal">
        <p class="prompt-question">{prompts[0].question}</p>
        <p class="prompt-answer stagger-text">{prompts[0].answer}</p>
      </div>
    </div>

    <div class="route reveal">
      <p class="route-label">The Route</p>
      <div class="route-strip" id="routeStrip">
        {photos.map((photo, i) => (
          <button class="route-thumb" data-index={i} aria-label={`Open photo ${i + 1} of ${photos.length}`}>
            <img src={photo.thumb} alt={photo.alt} loading="lazy" />
          </button>
        ))}
      </div>
    </div>

    <div class="trail-waypoint" data-waypoint="conversation">
      <span class="trail-dot"></span>
      <span class="trail-label">First conversation</span>
      <div class="prompt-card reveal">
        <p class="prompt-question">{prompts[1].question}</p>
        <p class="prompt-answer stagger-text">{prompts[1].answer}</p>
      </div>
    </div>

    <div class="faith-block reveal">
      <p class="faith-label">My Faith</p>
      <div class="chip-grid">
        {faithChips.map((chip) => (
          <span class="chip">{chip}</span>
        ))}
      </div>
    </div>

    <div class="trail-waypoint" data-waypoint="date">
      <span class="trail-dot"></span>
      <span class="trail-label">First date</span>
      <div class="prompt-card reveal">
        <p class="prompt-question">{prompts[2].question}</p>
        <p class="prompt-answer stagger-text">{prompts[2].answer}</p>
      </div>
    </div>

    <div class="bio-block reveal">
      <p class="bio-label">About</p>
      {bio.map((paragraph) => (
        <p class="bio-paragraph stagger-text">{paragraph}</p>
      ))}
    </div>

    <div class="trail-waypoint" data-waypoint="family">
      <span class="trail-dot"></span>
      <span class="trail-label">Meet the family</span>
      <div class="prompt-card reveal">
        <p class="prompt-question">{prompts[3].question}</p>
        <p class="prompt-answer stagger-text">{prompts[3].answer}</p>
      </div>
    </div>

    <div class="interests-block">
      <div class="faith-block reveal">
        <p class="faith-label">Interests</p>
        <div class="chip-grid">
          {interestChips.map((chip) => (
            <span class="chip">{chip}</span>
          ))}
        </div>
      </div>
      <div class="faith-block reveal">
        <p class="faith-label">Personality</p>
        <div class="chip-grid">
          {personalityChips.map((chip) => (
            <span class="chip">{chip}</span>
          ))}
        </div>
      </div>
    </div>

    <div class="trail-waypoint" data-waypoint="forever">
      <span class="trail-dot"></span>
      <span class="trail-label">Forever</span>
      <div class="cta-block reveal">
        <p class="cta-text">If this trail looks like one you'd want to walk too —</p>
        <a href="mailto:ashif@ashifkhan.com" class="cta-btn">Get in touch</a>
      </div>
    </div>
  </div>

    <div class="lightbox" id="lightbox" aria-hidden="true">
      <button class="lightbox-close" id="lightboxClose" aria-label="Close">✕</button>
      <button class="lightbox-prev" id="lightboxPrev" aria-label="Previous photo">‹</button>
      <img class="lightbox-img" id="lightboxImg" src="" alt="" />
      <button class="lightbox-next" id="lightboxNext" aria-label="Next photo">›</button>
    </div>

  <style>
    :global(:root) {
      --ease-premium: cubic-bezier(0.16, 1, 0.3, 1);
    }

    .trailhead {
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 92vh;
      background: var(--ink);
    }

    .trailhead-photo {
      position: relative;
      overflow: hidden;
    }

    .trailhead-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transform: scale(1.04);
    }

    .trailhead-photo-scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        90deg,
        transparent 55%,
        rgba(14, 14, 13, 0.55) 100%
      );
      pointer-events: none;
    }

    .trailhead-content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 5vw 6vw;
    }

    .hero-in {
      opacity: 0;
      transform: translateY(22px);
      animation: heroIn 1.1s var(--ease-premium) forwards;
    }

    .hero-in-1 { animation-delay: 0.1s; }
    .hero-in-2 { animation-delay: 0.25s; }
    .hero-in-3 { animation-delay: 0.42s; }

    @keyframes heroIn {
      to { opacity: 1; transform: translateY(0); }
    }

    .trailhead-kicker {
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--accent-light);
      margin-bottom: 1.75rem;
    }

    .trailhead-name {
      font-family: var(--serif);
      font-size: clamp(3.25rem, 7vw, 6.25rem);
      line-height: 0.98;
      color: var(--paper);
      letter-spacing: -0.035em;
      margin-bottom: 1.5rem;
    }

    .trailhead-tag {
      color: rgba(250, 249, 247, 0.55);
      font-size: 1.1875rem;
      font-weight: 300;
      line-height: 1.6;
      max-width: 34ch;
      letter-spacing: -0.005em;
    }

    @media (max-width: 768px) {
      .trailhead {
        grid-template-columns: 1fr;
        min-height: auto;
      }
      .trailhead-photo {
        aspect-ratio: 4 / 5;
      }
      .trailhead-photo-scrim {
        background: linear-gradient(180deg, transparent 55%, rgba(14, 14, 13, 0.65) 100%);
      }
      .trailhead-content {
        padding: 3rem 1.5rem 3.5rem;
      }
    }

    /* ── FIELD STATS ── */
    .field-stats {
      background: var(--paper-warm);
      border-bottom: 1px solid var(--border);
    }

    .field-stats-inner {
      padding: 1.75rem 2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 1.25rem;
    }

    .field-stat {
      font-size: 0.8125rem;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink-light);
      white-space: nowrap;
    }

    .field-stat-divider {
      width: 1px;
      height: 12px;
      background: var(--border-med);
    }

    @media (max-width: 640px) {
      .field-stats-inner {
        gap: 0.85rem;
        padding: 1.5rem 1.25rem;
      }
      .field-stat {
        font-size: 0.75rem;
      }
    }

    /* ── TRAIL ── */
    .trail {
      position: relative;
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 8rem 2rem 8rem 4rem;
      background:
        radial-gradient(60% 40% at 8% 0%, rgba(200, 80, 26, 0.06), transparent 70%),
        radial-gradient(50% 35% at 100% 60%, rgba(200, 80, 26, 0.04), transparent 70%),
        var(--paper);
    }

    .trail :global(.reveal) {
      transition-timing-function: var(--ease-premium);
      transition-duration: 0.9s;
    }

    .trail-track {
      position: absolute;
      left: 2rem;
      top: 5rem;
      bottom: 5rem;
      width: 2px;
      background: var(--border);
      pointer-events: none;
    }

    .trail-progress {
      position: absolute;
      left: 0;
      top: 0;
      width: 2px;
      height: 0%;
      background: linear-gradient(180deg, var(--accent-light), var(--accent));
      box-shadow: 0 0 16px 1px rgba(200, 80, 26, 0.35);
    }

    .trail-waypoint {
      position: relative;
      margin-bottom: 6.5rem;
      padding-left: 2rem;
    }

    .trail-waypoint:last-child {
      margin-bottom: 0;
    }

    .trail-dot {
      position: absolute;
      left: -2.4rem;
      top: 0.15rem;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--paper);
      border: 2px solid var(--border-med);
      transition: background 0.3s, border-color 0.3s, transform 0.3s;
    }

    .trail-waypoint.lit .trail-dot {
      background: var(--accent);
      border-color: var(--accent);
      transform: scale(1.2);
    }

    .trail-label {
      display: block;
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin-bottom: 1rem;
      transition: color 0.3s;
    }

    .trail-waypoint.lit .trail-label {
      color: var(--accent);
    }

    .prompt-card {
      background: var(--paper-warm);
      border: none;
      border-radius: 20px;
      padding: 2.75rem;
      max-width: 62ch;
      box-shadow: 0 1px 2px rgba(14, 14, 13, 0.03), 0 16px 40px -24px rgba(14, 14, 13, 0.14);
    }

    .prompt-question {
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin-bottom: 1rem;
    }

    .prompt-answer {
      font-family: var(--serif);
      font-size: 1.625rem;
      line-height: 1.42;
      color: var(--ink);
      letter-spacing: -0.015em;
    }

    @media (max-width: 768px) {
      .trail {
        padding: 4rem 1.25rem 4rem 3rem;
      }
      .trail-waypoint {
        margin-bottom: 4rem;
      }
      .trail-track {
        left: 1.25rem;
      }
      .trail-dot {
        left: -1.65rem;
      }
      .prompt-card {
        padding: 1.75rem;
        border-radius: 16px;
      }
      .prompt-answer {
        font-size: 1.25rem;
      }
    }

    /* ── ROUTE (GALLERY) ── */
    .route {
      margin: 0 -4rem 0 -4rem;
      padding: 0 4rem;
    }

    .route-label {
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin-bottom: 1rem;
    }

    .route-strip {
      display: flex;
      gap: 0.75rem;
      overflow-x: auto;
      overflow-y: visible;
      scroll-snap-type: x mandatory;
      padding: 1rem 0 0.5rem;
    }

    .route-thumb {
      flex: 0 0 auto;
      width: 240px;
      aspect-ratio: 3 / 4;
      border: none;
      border-radius: 18px;
      overflow: hidden;
      padding: 0;
      cursor: pointer;
      scroll-snap-align: start;
      background: var(--paper-warm);
      transform-origin: center bottom;
      transition: transform 0.35s var(--ease-premium), box-shadow 0.35s var(--ease-premium);
      box-shadow: 0 1px 2px rgba(14, 14, 13, 0.04), 0 12px 28px -18px rgba(14, 14, 13, 0.22);
      will-change: transform;
    }

    .route-thumb:hover {
      box-shadow: 0 1px 2px rgba(14, 14, 13, 0.05), 0 24px 48px -20px rgba(14, 14, 13, 0.32);
    }

    .route-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* ── LIGHTBOX ── */
    .lightbox {
      position: fixed;
      inset: 0;
      background: rgba(14, 14, 13, 0.85);
      backdrop-filter: blur(28px) saturate(1.4);
      -webkit-backdrop-filter: blur(28px) saturate(1.4);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.4s var(--ease-premium);
      z-index: 200;
    }

    .lightbox.open {
      opacity: 1;
      pointer-events: auto;
    }

    .lightbox-img {
      max-width: min(88vw, 900px);
      max-height: 85vh;
      object-fit: contain;
      border-radius: 14px;
      box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.6);
    }

    .lightbox-close,
    .lightbox-prev,
    .lightbox-next {
      position: absolute;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: rgba(250, 249, 247, 0.08);
      border: 1px solid rgba(250, 249, 247, 0.16);
      color: var(--paper);
      font-size: 1.375rem;
      cursor: pointer;
      opacity: 0.85;
      transition: opacity 0.2s, background 0.2s, transform 0.2s;
    }

    .lightbox-close:hover,
    .lightbox-prev:hover,
    .lightbox-next:hover {
      opacity: 1;
      background: rgba(250, 249, 247, 0.16);
      transform: scale(1.06);
    }

    .lightbox-close {
      top: 1.5rem;
      right: 1.5rem;
    }

    .lightbox-prev {
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
    }

    .lightbox-next {
      right: 1rem;
      top: 50%;
      transform: translateY(-50%);
    }

    @media (max-width: 768px) {
      .route {
        margin: 0 -1.25rem;
        padding: 0 1.25rem;
      }
      .route-thumb {
        width: 150px;
      }
    }

    /* ── FAITH / CHIP GRID ── */
    .faith-block {
      margin-bottom: 4rem;
    }

    .faith-label {
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin-bottom: 1rem;
    }

    .chip-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      max-width: 60ch;
    }

    /* ── BIO ── */
    .bio-block {
      margin-bottom: 4rem;
      max-width: 60ch;
    }

    .bio-label {
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin-bottom: 1rem;
    }

    .bio-paragraph {
      color: var(--ink-light);
      line-height: 1.75;
      font-weight: 300;
      margin-bottom: 1rem;
    }

    .bio-paragraph:last-child {
      margin-bottom: 0;
    }

    .interests-block .faith-block:last-child {
      margin-bottom: 4rem;
    }

    /* ── CTA ── */
    .cta-block {
      max-width: 60ch;
    }

    .cta-text {
      font-family: var(--serif);
      font-size: clamp(1.75rem, 3vw, 2.25rem);
      color: var(--ink);
      line-height: 1.25;
      letter-spacing: -0.015em;
      margin-bottom: 2rem;
    }

    .cta-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      background: var(--ink);
      color: var(--paper);
      font-size: 0.9375rem;
      font-weight: 500;
      letter-spacing: -0.005em;
      padding: 1rem 1.75rem;
      border-radius: 100px;
      text-decoration: none;
      box-shadow: 0 1px 2px rgba(14, 14, 13, 0.08), 0 20px 40px -18px rgba(14, 14, 13, 0.35);
      transition: transform 0.35s var(--ease-premium), box-shadow 0.35s var(--ease-premium);
    }

    .cta-btn::after {
      content: '→';
      transition: transform 0.35s var(--ease-premium);
    }

    .cta-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 1px 2px rgba(14, 14, 13, 0.08), 0 28px 52px -16px rgba(14, 14, 13, 0.42);
    }

    .cta-btn:hover::after {
      transform: translateX(3px);
    }

    /* ── CHIPS (page-local refinement) ── */
    .chip-grid .chip,
    .field-stats-inner .chip {
      background: transparent;
      border: 1px solid var(--border-med);
      color: var(--ink-light);
      font-weight: 400;
      letter-spacing: 0.01em;
      transition: border-color 0.25s var(--ease-premium), color 0.25s var(--ease-premium), transform 0.25s var(--ease-premium);
    }

    .chip-grid .chip:hover {
      border-color: var(--accent);
      color: var(--accent);
      transform: translateY(-1px);
    }

    /* ── SCROLL-TRIGGERED TEXT ── */
    /* One-shot: word spans start blurred/offset, resolve to normal once
       the paragraph's IntersectionObserver adds .in-view. No continuous
       loop, no mouse dependency - same mechanism as .reveal. */
    .stagger-text .sword {
      display: inline-block;
      opacity: 0;
      transform: translateY(0.4em);
      filter: blur(6px);
      transition: opacity 0.6s var(--ease-premium), transform 0.6s var(--ease-premium), filter 0.6s var(--ease-premium);
      transition-delay: calc(var(--i) * 28ms);
    }

    .stagger-text.in-view .sword {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }

    @media (prefers-reduced-motion: reduce) {
      .stagger-text .sword {
        transition: none;
        opacity: 1;
        transform: none;
        filter: none;
      }
    }

    /* ── SCROLL-TRIGGERED PHOTOS ── */
    .route-thumb img {
      filter: grayscale(1) saturate(1);
      opacity: 0;
      transform: scale(1.08);
      transition: filter 0.9s var(--ease-premium), opacity 0.7s var(--ease-premium), transform 0.9s var(--ease-premium);
      transition-delay: calc(var(--i) * 70ms);
    }

    .route-thumb.in-view img {
      filter: grayscale(0) saturate(1);
      opacity: 1;
      transform: scale(1);
    }

    .route-thumb:hover img {
      filter: grayscale(0) saturate(1.25);
      transform: scale(1.04);
    }

    @media (prefers-reduced-motion: reduce) {
      .route-thumb img {
        transition: filter 0.3s, transform 0.3s;
        opacity: 1;
        transform: none;
        filter: grayscale(0);
      }
    }
  </style>

  <script define:vars={{ photos }}>
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightboxImg');
    const closeBtn = document.getElementById('lightboxClose');
    const prevBtn = document.getElementById('lightboxPrev');
    const nextBtn = document.getElementById('lightboxNext');
    const thumbs = document.querySelectorAll('.route-thumb');
    let currentIndex = 0;

    function showPhoto() {
      const photo = photos[currentIndex];
      lightboxImg.src = photo.full;
      lightboxImg.alt = photo.alt;
    }

    function openLightbox(index) {
      currentIndex = index;
      showPhoto();
      lightbox.classList.add('open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox.classList.remove('open');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function nextPhoto() {
      currentIndex = (currentIndex + 1) % photos.length;
      showPhoto();
    }

    function prevPhoto() {
      currentIndex = (currentIndex - 1 + photos.length) % photos.length;
      showPhoto();
    }

    thumbs.forEach((btn, i) => btn.addEventListener('click', () => openLightbox(i)));
    closeBtn?.addEventListener('click', closeLightbox);
    nextBtn?.addEventListener('click', nextPhoto);
    prevBtn?.addEventListener('click', prevPhoto);

    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox?.classList.contains('open')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') nextPhoto();
      if (e.key === 'ArrowLeft') prevPhoto();
    });

    let touchStartX = 0;
    lightboxImg?.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0].clientX;
    });
    lightboxImg?.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      if (dx > 50) prevPhoto();
      if (dx < -50) nextPhoto();
    });
  </script>

  <script>
    const trail = document.getElementById('trail');
    const trailProgress = document.getElementById('trailProgress');

    function updateTrailProgress() {
      if (!trail || !trailProgress) return;
      const rect = trail.getBoundingClientRect();
      const total = rect.height;
      if (total <= 0) return;
      const viewed = Math.min(Math.max(window.innerHeight * 0.5 - rect.top, 0), total);
      const pct = (viewed / total) * 100;
      trailProgress.style.height = pct.toFixed(2) + '%';
    }

    window.addEventListener('scroll', updateTrailProgress, { passive: true });
    window.addEventListener('resize', updateTrailProgress);
    updateTrailProgress();

    const waypointObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('lit');
          }
        });
      },
      { threshold: 0.5 }
    );

    document.querySelectorAll('.trail-waypoint').forEach((el) => waypointObserver.observe(el));
  </script>

  <script>
    // ── Word-by-word text reveal ──
    // One-shot: wrap each word in a span carrying its index, then let a single
    // IntersectionObserver flip .in-view on the paragraph when it scrolls into
    // view. CSS transition-delay (keyed off --i) staggers the words. No
    // continuous loop, no mouse dependency - this is the same proven pattern
    // as the site-wide .reveal fade-in and the trail-dot "lit" state.
    document.querySelectorAll('.stagger-text').forEach((el) => {
      const text = el.textContent;
      el.textContent = '';
      const frag = document.createDocumentFragment();
      let wordIndex = 0;
      text.split(/(\s+)/).forEach((chunk) => {
        if (chunk.trim() === '') {
          frag.appendChild(document.createTextNode(chunk));
        } else {
          const span = document.createElement('span');
          span.className = 'sword';
          span.style.setProperty('--i', String(wordIndex++));
          span.textContent = chunk;
          frag.appendChild(span);
        }
      });
      el.appendChild(frag);
    });

    const textObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            textObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
    );
    document.querySelectorAll('.stagger-text').forEach((el) => textObserver.observe(el));

    // ── Photo reveal: grayscale to color as each thumbnail scrolls into view ──
    const routeThumbs = Array.from(document.querySelectorAll('.route-thumb'));
    routeThumbs.forEach((btn, i) => btn.style.setProperty('--i', String(i)));

    const routeStripEl = document.getElementById('routeStrip');
    const photoObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            photoObserver.unobserve(entry.target);
          }
        });
      },
      { root: routeStripEl, threshold: 0.4 }
    );
    routeThumbs.forEach((btn) => photoObserver.observe(btn));
  </script>
</BaseLayout>
